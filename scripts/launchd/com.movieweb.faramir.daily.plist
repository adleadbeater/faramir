<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Faramir daily run on Rob's Mac: 2pm local time, every day. If the Mac is asleep at 2pm, launchd
     runs it on wake. Install: cp to ~/Library/LaunchAgents and `launchctl bootstrap gui/$(id -u) <file>`. -->
<plist version="1.0">
<dict>
    <key>Label</key><string>com.movieweb.faramir.daily</string>
    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/Robert/Downloads/faramir/scripts/daily_run.sh</string>
    </array>
    <key>StartCalendarInterval</key>
    <dict><key>Hour</key><integer>14</integer><key>Minute</key><integer>0</integer></dict>
    <key>StandardOutPath</key><string>/Users/Robert/Downloads/faramir/out/logs/launchd.out.log</string>
    <key>StandardErrorPath</key><string>/Users/Robert/Downloads/faramir/out/logs/launchd.err.log</string>
    <key>RunAtLoad</key><false/>
</dict>
</plist>
